# iguana-asistente · configuración. Copiar a .env y llenar. NUNCA commitear el .env real.

# ── LLM (proveedor conmutable) ────────────────────────────────────────────────
# anthropic = Claude Haiku 4.5 (producción). deepseek = DeepSeek-V3 (para PROBAR ya, sin pagar Anthropic).
LLM_PROVIDER=anthropic

# --- si LLM_PROVIDER=anthropic ---
# Llave de console.anthropic.com (pago por uso). NO es la suscripción de chat de claude.ai.
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5
LLM_MODEL_ESCALADA=claude-sonnet-5

# --- si LLM_PROVIDER=deepseek (para pruebas) ---
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat        # V3, soporta tool-calling (NO deepseek-reasoner para el agente)

# ── Base de datos propia del asistente (pgvector) ─────────────────────────────
DATABASE_URL=postgresql://asistente:asistente@pgvector:5432/asistente
# Clave para cifrar/descifrar los service_token del registro (app-level). Generar 32 bytes aleatorios.
ASISTENTE_SECRET_KEY=

# ── Puente de WhatsApp (Fase 0: Baileys) ──────────────────────────────────────
# URL interna donde el puente Node expone su envío de mensajes (el asistente le pega para responder).
BRIDGE_URL=http://bridge:3100
# URL interna donde el asistente Python recibe los mensajes entrantes del puente.
ASISTENTE_URL=http://asistente:8000

# ── Voz (opcional) ────────────────────────────────────────────────────────────
VOZ_HABILITADA=true
WHISPER_MODEL=small          # tiny|base|small|medium — small va bien en CPU para español
TTS_MOTOR=piper              # piper (self-host) | polly | elevenlabs
# Si TTS_MOTOR=polly o elevenlabs, sus credenciales van acá:
# AWS_ACCESS_KEY_ID=  AWS_SECRET_ACCESS_KEY=  AWS_REGION=us-east-1
# ELEVENLABS_API_KEY=

# ── Alarmas de dinero (vigilante proactivo) ───────────────────────────────────
# Avisa a los admin/encargado cuando: una banca queda descubierta de un premio (no lo cubre con su
# caja) o cuando un número está caliente (misma jugada en muchas bancas = dato filtrado).
ALARMAS_PUSH=true
ALARMAS_INTERVALO_SEG=90       # cada cuánto revisa el riesgo de cada consorcio
ALARMAS_COOLDOWN_MIN=30        # no repetir la misma alarma dentro de esta ventana
VELOCIDAD_VENTANA_MIN=60       # ventana del "número caliente" cross-banca
UMBRAL_GANADOR=20000          # un ticket que YA ganó un premio >= a esto (RD$) → alarma de ganador real

# ── Reportes ──────────────────────────────────────────────────────────────────
REPORTE_PDF=true
REPORTE_EOD_HORA=21:30
REPORTE_TZ=America/Santo_Domingo
REPORTE_EOD_AUTO=false         # ⚠ Baileys + envío masivo bot-inicia = riesgo de baneo; prender solo pocos/pruebas

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Número desconocido = no se le sirve nada. Si en true, además avisa "no te reconozco".
AVISAR_DESCONOCIDOS=true
